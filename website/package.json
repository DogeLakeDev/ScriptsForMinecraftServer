{
  "name": "@sfmc-bds/docs-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../packages/tools/docs-typedoc.mjs",
    "dev": "rspress dev --port 3000 --host 0.0.0.0",
    "prebuild": "node ../packages/tools/docs-typedoc.mjs",
    "build": "rspress build",
    "postbuild": "node -e \"const fs=require('node:fs'), path=require('node:path'); const src=path.resolve('doc_build'), dest=path.resolve('dist'); if(fs.existsSync(src)){fs.mkdirSync(dest, {recursive: true}); fs.cpSync(src, dest, {recursive: true});}\"",
    "preview": "rspress preview --port 3000 --host 0.0.0.0"
  },
  "dependencies": {
    "@rspress/core": "^2.0.19",
    "@rspress/plugin-client-redirects": "^2.0.19",
    "mermaid": "^10.9.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rspress-plugin-devkit": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.2"
  }
}
