{
  "name": "@sfmc-bds/devkit",
  "version": "0.1.0-beta.2",
  "description": "SFMC module authoring toolkit — watch, scaffold, rebuild (for VS Code extension & tooling)",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./new-module.mjs": "./scripts/new-module.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "sfmc-new-module": "./scripts/new-module.mjs"
  },
  "files": [
    "dist",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc7 --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sfmc-bds/bds-tools": "^0.2.0-beta.8",
    "@sfmc-bds/cli": "^0.2.0-beta.10",
    "@sfmc-bds/sdk": "^0.2.0-beta.8"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
