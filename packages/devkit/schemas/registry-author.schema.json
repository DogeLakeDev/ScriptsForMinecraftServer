{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SFMC 模块作者索引展示配置",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "description": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "category": { "enum": ["gameplay", "utility", "system", "economy", "social"] },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } },
    "authors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    }
  }
}
