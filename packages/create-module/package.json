{
  "name": "@sfmc-bds/create-module",
  "version": "0.1.0-beta.0",
  "description": "Create an SFMC SAPI module — npm create @sfmc-bds/module",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "create-sfmc-module": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc7 --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/create-module.test.js"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@sfmc-bds/tools": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}

