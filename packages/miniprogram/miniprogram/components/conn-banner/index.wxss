.conn-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  padding: 32px 24px;
  text-align: center;
}
/* 大号图标底块 .tile-lg 见 styles/base.wxss */
.conn-empty-title {
  margin-top: 4px;
  font-size: var(--fs-title-3);
  line-height: var(--lh-title-3);
  letter-spacing: var(--ls-title-3);
  font-weight: 600;
}
.conn-empty-desc {
  margin-bottom: 8px;
  color: var(--c-text-3);
  font-size: var(--fs-subheadline);
  line-height: var(--lh-subheadline);
  letter-spacing: var(--ls-subheadline);
}
.conn-actions {
  margin-top: 10px;
}
