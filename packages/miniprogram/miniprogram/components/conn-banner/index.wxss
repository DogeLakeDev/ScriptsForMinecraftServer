.conn-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  padding: 32px 24px;
  text-align: center;
}
.tile-lg {
  width: 48px;
  height: 48px;
  border-radius: 14px;
}
.conn-empty-title {
  margin-top: 4px;
  font-size: 17px;
  line-height: 24px;
  font-weight: 600;
}
.conn-empty-desc {
  margin-bottom: 8px;
  color: var(--c-text-3);
  font-size: 13px;
  line-height: 20px;
}
.conn-actions {
  margin-top: 10px;
}
