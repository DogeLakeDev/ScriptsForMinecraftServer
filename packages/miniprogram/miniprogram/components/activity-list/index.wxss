.activity-list {
  display: flex;
  flex-direction: column;
}
.activity-item + .activity-item {
  border-top: 0.5px solid var(--c-line);
}
.activity-row {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 10px 12px;
}
.activity-row.hover {
  background: var(--c-fill);
}
.activity-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.activity-title {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 14px;
  line-height: 20px;
  font-weight: 500;
}
.activity-detail {
  color: var(--c-text-2);
  font-size: 13px;
  line-height: 18px;
  word-break: break-all;
}
.activity-meta {
  color: var(--c-text-3);
  font-size: 12px;
  line-height: 16px;
}
.activity-extra {
  display: flex;
  flex-direction: column;
  gap: 8px;
  /* 与标题左缘对齐：行内边距 12 + 图标 32 + 间距 10 */
  padding: 0 12px 12px 54px;
}
