.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 32px 16px;
  text-align: center;
}
.empty.compact {
  padding: 20px 16px;
}
.empty-title {
  color: var(--c-text-2);
  font-weight: 600;
}
.empty-desc {
  color: var(--c-text-3);
  font-size: 12px;
  line-height: 18px;
}
