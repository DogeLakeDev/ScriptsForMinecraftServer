.player-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.player-chip {
  display: flex;
  align-items: center;
  gap: 6px;
  height: 32px;
  padding: 0 12px 0 4px;
  border-radius: 999px;
  background: var(--c-fill);
}
.player-chip.stale {
  opacity: 0.55;
}
.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 32px;
  height: 32px;
  border-radius: 999px;
  color: #fff;
  font-size: 14px;
  font-weight: 600;
}
.avatar-sm {
  width: 24px;
  height: 24px;
  font-size: 12px;
}
.kinds {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding-bottom: 4px;
}
.task-end {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
  flex: none;
}
.add-row {
  padding: 8px;
}
.json-editor {
  width: 100%;
  height: 320px;
  padding: 10px 12px;
  border-radius: 12px;
  background: var(--c-fill);
  box-sizing: border-box;
  font-size: 12px;
  line-height: 18px;
  color: var(--c-text);
}
.form {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding-bottom: 8px;
  text-align: left;
}
.field-input-fill {
  background: var(--c-fill);
  display: flex;
  align-items: center;
}
.picker-value {
  justify-content: space-between;
}
.sheet-actions {
  display: flex;
  gap: 10px;
  width: 100%;
}
