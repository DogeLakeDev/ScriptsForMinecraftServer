/* 头像、弹窗表单、弹窗按钮行、行尾两行布局已移到 styles/base.wxss（.avatar / .sheet-form / .sheet-buttons / .list-end-stack） */
.player-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
/* 在线玩家胶囊：iOS Small 胶囊按钮的灰底，左侧嵌小头像 */
.player-chip {
  display: flex;
  align-items: center;
  gap: 6px;
  height: 32px;
  padding: 0 12px 0 4px;
  border-radius: var(--radius-full);
  background: var(--c-fill);
  font-size: var(--fs-subheadline);
  letter-spacing: var(--ls-subheadline);
}
.player-chip.stale {
  opacity: 0.55;
}
.kinds {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding-bottom: 4px;
}
.add-row {
  padding: 8px 16px 12px;
}
.json-editor {
  width: 100%;
  height: 320px;
  padding: 10px 12px;
  border-radius: var(--radius-l);
  background: var(--c-fill);
  box-sizing: border-box;
  font-size: 12px;
  line-height: 18px;
  color: var(--c-text);
}
.picker-value {
  justify-content: space-between;
}
