.instance-head {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 0 -8px;
  padding: 6px 8px;
  border-radius: var(--radius-l);
}
.instance-head.hover {
  background: var(--c-fill);
}

/*
 * 状态条：2×2 网格（桌面端为一行四格）。iOS 风格的指标小卡：分组卡片底色，二级文字色标签 + Title 2 数值；
 * 告警（TPS 偏低）只把数值染成橙色，卡片底色不变，保证对比度。
 */
.strip {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
.strip-item {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 12px 16px;
  border-radius: var(--radius-xl);
  background: var(--c-block);
}
.strip-item.hover {
  opacity: 0.6;
}
.strip-label {
  color: var(--c-text-2);
  font-size: var(--fs-footnote);
  line-height: var(--lh-footnote);
  letter-spacing: var(--ls-footnote);
}
.strip-value {
  color: var(--c-text);
  font-size: var(--fs-title-2);
  line-height: var(--lh-title-2);
  letter-spacing: var(--ls-title-2);
  font-weight: 600;
}
.strip-value.text-warning {
  color: var(--c-warning-text);
}
.strip-total {
  margin-left: 2px;
  color: var(--c-text-3);
  font-size: var(--fs-footnote);
  font-weight: 400;
}

.chart-note {
  margin-bottom: 8px;
}
.memory-panel {
  margin: 12px 0 4px;
}
.memory-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
  margin: 8px 0 2px;
  font-size: var(--fs-subheadline);
  line-height: var(--lh-subheadline);
  letter-spacing: var(--ls-subheadline);
}
/* 进度条：iOS Progress View，4px 胶囊，填充用强调色 */
.memory-meter {
  height: 4px;
  margin: 6px 0 4px;
  overflow: hidden;
  border-radius: var(--radius-full);
  background: var(--c-fill-2);
}
.memory-meter view {
  height: 100%;
  border-radius: inherit;
  background: var(--c-accent);
}
.memory-note {
  color: var(--c-text-3);
  font-size: var(--fs-footnote);
  line-height: var(--lh-footnote);
}
.memory-process {
  margin-top: 8px;
}
.chart-span {
  margin-bottom: 4px;
}
.chart-label {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  row-gap: 4px;
  margin: 12px 0 4px;
  color: var(--c-text-2);
  font-size: var(--fs-caption-1);
  line-height: var(--lh-caption-1);
}
.chart-label:first-child {
  margin-top: 0;
}

.detail-link {
  margin-top: 12px;
}
