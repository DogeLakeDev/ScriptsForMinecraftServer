@import "../../../templates/activity.wxss";

/* 统计格的标签 + 数值样式在 styles/base.wxss（.stat / .stat-value） */
.activity-filters {
  flex-wrap: wrap;
  gap: 6px;
}
.activity-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
}
.activity-section {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.activity-bar {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 6px 8px;
  margin: 0 -8px;
  border-radius: 10px;
}
.activity-bar.hover,
.activity-bar.active {
  background: var(--c-fill);
}
.activity-bar-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  font-size: var(--fs-subheadline);
  line-height: var(--lh-subheadline);
  letter-spacing: var(--ls-subheadline);
}
.activity-bar-track {
  height: 4px;
  border-radius: var(--radius-full);
  background: var(--c-fill-2);
  overflow: hidden;
}
.activity-bar-fill {
  height: 100%;
  border-radius: var(--radius-full);
  background: var(--c-primary);
}
.activity-players {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
