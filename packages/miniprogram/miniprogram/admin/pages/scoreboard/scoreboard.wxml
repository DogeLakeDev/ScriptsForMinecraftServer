<import src="/admin/templates/scoreboard.wxml" />
<view class="page">
  <conn-banner />
  <template is="scoreboard-status" data="{{note, noteTone, truncated}}" />

  <!-- 读取失败且没有可显示的数据 -->
  <view wx:if="{{error && !loaded}}" class="surface">
    <empty-state icon="alert" title="读取计分板失败" desc="{{error}}" compact>
      <view class="btn btn-sm" hover-class="hover" bindtap="reload">重试</view>
    </empty-state>
  </view>

  <!-- 计分项列表：点按进入详情，左滑删除 -->
  <view class="section">
    <view class="section-header">
      <view class="section-title">
        <view>计分项</view>
        <view class="section-sub">{{loading && !loaded ? '正在读取…' : synced || '尚无快照'}}</view>
      </view>
      <view class="btn btn-sm btn-primary {{canEdit && !saving ? '' : 'disabled'}}" hover-class="hover" bindtap="openObjectiveForm">
        <text>新建</text>
      </view>
    </view>
    <view wx:if="{{objectives.length || objectiveKeyword}}" class="search glass">
      <text class="i i-search"></text>
      <input value="{{objectiveKeyword}}" placeholder="搜索计分项" placeholder-class="placeholder" bindinput="onObjectiveKeyword" />
      <text wx:if="{{objectiveKeyword}}" class="i i-x" bindtap="clearObjectiveKeyword"></text>
    </view>
    <view wx:if="{{objectives.length}}" class="surface surface-list">
      <swipe-row
        wx:for="{{objectives}}"
        wx:key="id"
        divider="{{index > 0}}"
        disabled="{{!canEdit || saving}}"
        action-label="删除"
        data-id="{{item.id}}"
        bindaction="removeObjective"
      >
        <view class="list-item" hover-class="hover" data-id="{{item.id}}" bindtap="openObjective">
          <view class="tile tile-orange"><text class="i i-trophy"></text></view>
          <view class="list-main">
            <view class="list-title">
              <text class="truncate">{{item.title}}</text>
              <text wx:if="{{item.shown}}" class="i i-sm i-eye muted" aria-label="显示在游戏内"></text>
            </view>
          </view>
          <text class="list-end num">{{item.count}} 人</text>
          <text class="i i-sm i-chevron-right muted"></text>
        </view>
      </swipe-row>
    </view>
    <view wx:elif="{{objectiveKeyword}}" class="surface">
      <empty-state icon="search" title="没有匹配的计分项" compact />
    </view>
    <view wx:elif="{{empty}}" class="surface">
      <empty-state icon="trophy" title="还没有计分项" desc="可以新建一个，或在游戏内用 /scoreboard objectives add 创建" compact />
    </view>
  </view>
</view>

<!-- 新建计分项 -->
<mp-half-screen-dialog show="{{!!objectiveForm}}" bindclose="closeObjectiveForm" title="新建计分项" subTitle="以 dummy 准则创建，分数只能通过命令或脚本修改">
  <view slot="desc" class="sheet-form">
    <view class="field">
      <text class="field-label">计分项 ID（必填）</text>
      <input class="field-input field-input-fill mono" value="{{objectiveForm.id}}" data-field="id" placeholder="例如 kills" placeholder-class="placeholder" bindinput="onObjectiveInput" />
      <text class="field-hint">命令中使用的名称</text>
      <text wx:if="{{objectiveForm.error}}" class="field-error">{{objectiveForm.error}}</text>
    </view>
    <view class="field">
      <text class="field-label">显示名称</text>
      <input class="field-input field-input-fill" value="{{objectiveForm.displayName}}" data-field="displayName" placeholder="例如 击杀数" placeholder-class="placeholder" bindinput="onObjectiveInput" />
      <text class="field-hint">可选，留空时显示 ID；支持 § 格式码</text>
    </view>
    <text wx:if="{{objectiveForm.command}}" class="code scoreboard-command" user-select>{{objectiveForm.command}}</text>
  </view>
  <view slot="footer" class="sheet-buttons">
    <view class="btn btn-lg spacer {{saving ? 'disabled' : ''}}" hover-class="hover" bindtap="closeObjectiveForm">取消</view>
    <view class="btn btn-lg btn-primary spacer {{saving ? 'disabled' : ''}}" hover-class="hover" bindtap="commitObjectiveForm">
      <text wx:if="{{saving}}" class="i i-sm i-loader spin"></text>
      <text>创建</text>
    </view>
  </view>
</mp-half-screen-dialog>
