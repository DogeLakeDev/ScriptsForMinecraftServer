<view class="page">
  <view class="field">
    <text class="field-label">名称</text>
    <input class="field-input" value="{{name}}" placeholder="例如 生存服" placeholder-class="placeholder" bindinput="onName" />
  </view>
  <view class="field">
    <text class="field-label">网关地址</text>
    <input
      class="field-input mono"
      value="{{endpoint}}"
      placeholder="https://mc.example.com/sfmc"
      placeholder-class="placeholder"
      type="text"
      bindinput="onEndpoint"
    />
    <text class="field-hint">反向代理到 sfmc-mp-gateway 的 HTTPS 地址，不含 /manage。</text>
    <view wx:if="{{insecure}}" class="callout tone-warning">
      <text class="i i-warning"></text>
      <view class="callout-body">
        <view class="callout-text">未加密地址只能在开发者工具（关闭域名校验）中使用，正式版小程序仅允许 https / wss。</view>
      </view>
    </view>
  </view>
  <view wx:if="{{!wechat}}" class="field">
    <view class="row">
      <text class="field-label spacer">访问令牌</text>
      <text class="link" bindtap="pasteToken">粘贴</text>
      <text class="link" bindtap="toggleToken">{{showToken ? '隐藏' : '显示'}}</text>
    </view>
    <input
      class="field-input mono"
      value="{{token}}"
      password="{{!showToken}}"
      placeholder="网关首次启动时打印的令牌"
      placeholder-class="placeholder"
      bindinput="onToken"
    />
    <text class="field-hint">令牌保存在 &lt;部署目录&gt;/.sfmc/mp-gateway.json，只保存在本机。</text>
  </view>
  <view wx:else class="callout">
    <text class="i i-shield"></text>
    <view class="callout-body">
      <view class="callout-text">此实例使用微信管理员身份连接，无需访问令牌；网关每次连接都会核对你绑定的游戏账号是否为 3 级管理员。</view>
    </view>
  </view>

  <view wx:if="{{error}}" class="field-error">{{error}}</view>
  <view wx:if="{{testResult}}" class="callout {{testOk ? 'tone-success' : 'tone-danger'}}">
    <text class="i {{testOk ? 'i-check-circle' : 'i-x-circle'}}"></text>
    <view class="callout-body">
      <view class="callout-text" user-select>{{testResult}}</view>
    </view>
  </view>

  <view class="row actions">
    <view class="btn btn-lg btn-glass flex1" hover-class="hover" bindtap="test">
      <text class="i {{testing ? 'i-loader spin' : 'i-plug'}}"></text>
      <text>测试连接</text>
    </view>
    <view class="btn btn-lg btn-primary flex1" hover-class="hover" bindtap="save">
      <text class="i i-check"></text>
      <text>保存并连接</text>
    </view>
  </view>
  <view wx:if="{{id}}" class="btn btn-lg btn-danger-soft btn-block" hover-class="hover" bindtap="remove">
    <text class="i i-trash"></text>
    <text>删除实例</text>
  </view>
</view>
