.editor-page {
  display: flex;
  flex-direction: column;
  gap: 12px;
  height: 100vh;
  box-sizing: border-box;
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
}
.editor-head {
  gap: 6px;
}
.editor-box {
  flex: 1;
  min-height: 0;
  border-radius: var(--radius-xl);
  background: var(--c-block);
  overflow: hidden;
}
.editor {
  width: 100%;
  height: 100%;
  padding: 12px 16px;
  box-sizing: border-box;
  font-size: 12px;
  line-height: 18px;
  color: var(--c-text);
}
/* ---------- 表单视图：占满源码编辑框的位置，内部滚动；每组为一个 iOS 分组（组名在卡片外） ---------- */
.form-box {
  flex: 1;
  min-height: 0;
}
.form-group + .form-group {
  margin-top: 16px;
}
.form-list {
  padding: 0 16px;
}
/* 一行一个字段：标题与开关/选择器同行，输入框与说明在下方 */
.form-row {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 12px 0;
}
.form-row + .form-row {
  border-top: 0.5px solid var(--c-line);
}
.form-row-head {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 28px;
}
.form-row-text {
  flex: 1;
  min-width: 0;
}
/* 字段名：iOS 列表行 Body 17 */
.form-label {
  color: var(--c-text);
  font-size: var(--fs-body);
  line-height: var(--lh-body);
  letter-spacing: var(--ls-body);
}
.form-key {
  color: var(--c-text-3);
  font-size: var(--fs-caption-1);
  line-height: var(--lh-caption-1);
}
/* 枚举选择：iOS Pop-up Button 样式的灰底胶囊 */
.form-picker {
  display: flex;
  align-items: center;
  gap: 4px;
  max-width: 180px;
  height: 32px;
  padding: 0 10px 0 12px;
  border-radius: var(--radius-full);
  background: var(--c-fill);
  color: var(--c-text);
  font-size: var(--fs-subheadline);
  letter-spacing: var(--ls-subheadline);
}
.form-picker.disabled {
  opacity: 0.4;
}
.form-input {
  height: 44px;
  padding: 0 12px;
  border-radius: var(--radius-l);
  background: var(--c-fill);
  color: var(--c-text);
  font-size: var(--fs-body);
  letter-spacing: var(--ls-body);
  box-sizing: border-box;
}
/* 表单内的字段说明不再额外缩进（已在卡片内边距里） */
.form-row .field-hint {
  padding: 0;
}
.form-foot {
  padding: 8px 16px 4px;
}
.editor-loading {
  padding: 16px;
}
.editor-foot {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.foot-note {
  gap: 6px;
  color: var(--c-text-3);
}
.retry {
  margin-top: 6px;
}
