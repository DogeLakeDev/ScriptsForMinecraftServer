<view class="page">
  <view class="surface">
    <view class="surface-list">
      <view wx:for="{{profiles}}" wx:key="id" class="list-item" hover-class="hover" data-id="{{item.id}}" bindtap="select">
        <view class="tile {{item.current ? '' : 'tile-neutral'}}"><text class="i i-server"></text></view>
        <view class="list-main">
          <view class="list-title">
            <text class="truncate">{{item.name}}</text>
            <text wx:if="{{item.wechat}}" class="badge">微信身份</text>
            <text wx:if="{{item.label}}" class="badge tone-{{item.tone}}"><text class="dot tone-{{item.tone}}"></text>{{item.label}}</text>
          </view>
          <view class="list-sub truncate mono">{{item.endpoint}}</view>
        </view>
        <view class="btn btn-sm btn-icon btn-ghost" hover-class="hover" data-id="{{item.id}}" catchtap="edit">
          <text class="i i-sm i-pencil"></text>
        </view>
      </view>
      <empty-state wx:if="{{!profiles.length}}" icon="server" title="还没有实例" desc="添加服务器上运行的 sfmc-mp-gateway 网关" />
    </view>
  </view>
  <view class="btn btn-primary btn-lg btn-block" hover-class="hover" bindtap="add">
    <text class="i i-plus"></text>
    <text>添加实例</text>
  </view>
</view>
