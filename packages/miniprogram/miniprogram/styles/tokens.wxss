/*
 * tokens.wxss — 小程序专有的主题变量与页面底样式
 *
 * --c-* 颜色令牌不在这里：由 scripts/build-assets.mjs 按桌面端 @sfmc-bds/ui 的 palette.ts 生成到 styles/palette.wxss
 *（app.wxss 先引入它），浅色 / 深色随系统深色模式自动切换。
 * 这里只放小程序独有的部分：把 WeUI 组件使用的 --weui-* 变量映射到 --c-* 令牌（半屏弹窗、操作菜单等与页面配色统一），
 * 以及日志来源色亮度、等宽字体。
 */
page {
  --log-src-l: 42%;
  --font-mono: "JetBrains Mono", Menlo, Consolas, monospace;
  /* 管理端底部导航（components/admin-nav）的高度，不含底部安全区；页面用 .with-admin-nav 预留同样高度 */
  --admin-nav-height: 52px;

  --weui-BG-0: var(--c-bg);
  --weui-BG-1: var(--c-bg);
  --weui-BG-2: var(--c-block);
  --weui-BG-3: var(--c-fill-2);
  --weui-BG-4: var(--c-fill);
  --weui-BG-5: var(--c-block);
  --weui-FG-0: var(--c-text);
  --weui-FG-1: var(--c-text-2);
  --weui-FG-2: var(--c-text-3);
  --weui-FG-3: var(--c-line);
  --weui-FG-HALF: var(--c-text-2);
  --weui-RED: var(--c-danger);
  --weui-BRAND: var(--c-primary);
  --weui-LINK: var(--c-info-text);
  --weui-BTN-DEFAULT-BG: var(--c-fill-2);
  --weui-DIALOG-LINE-COLOR: var(--c-line);

  background: var(--c-bg);
  color: var(--c-text);
  font-size: 14px;
  line-height: 20px;
}

@media (prefers-color-scheme: dark) {
  page {
    --log-src-l: 70%;
    --weui-BG-5: var(--c-elevated);
  }
}
