/* 绑定码：大号等宽数字，便于对照输入 */
.me-code {
  margin-top: 4px;
  font-size: 36px;
  line-height: 48px;
  font-weight: 600;
  letter-spacing: 8px;
  text-align: center;
}
.me-center {
  text-align: center;
}
.me-steps {
  margin-top: 12px;
}
.me-retry {
  margin-top: 6px;
}
/* 已绑定资料卡：居中头像 + 2×2 统计格 */
.me-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding-top: 20px;
  padding-bottom: 20px;
}
.me-avatar {
  width: 64px;
  height: 64px;
  font-size: var(--fs-title-2);
}
.me-hero-name {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  max-width: 100%;
  font-size: var(--fs-title-3);
  line-height: var(--lh-title-3);
  font-weight: 600;
}
.me-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px 16px;
  width: 100%;
  margin-top: 12px;
}
.me-stat-value {
  font-size: var(--fs-body);
  line-height: var(--lh-body);
  font-weight: 600;
  word-break: break-all;
}
