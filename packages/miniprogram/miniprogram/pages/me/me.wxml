<view class="page with-tabbar">
  <view wx:if="{{!configured}}" class="callout tone-warning">
    <text class="i i-warning"></text>
    <view class="callout-body">
      <view class="callout-title">尚未配置服务器地址</view>
      <view class="callout-text">请在 core/server.ts 的 HOME_SERVER.endpoint 填写 mp-gateway 地址后重新编译。</view>
    </view>
  </view>

  <view wx:elif="{{error}}" class="callout tone-danger">
    <text class="i i-alert"></text>
    <view class="callout-body">
      <view class="callout-title">无法读取账号信息</view>
      <view class="callout-text">{{error}}</view>
      <view class="link me-retry" bindtap="load">重试</view>
    </view>
  </view>

  <!-- 账号 -->
  <view wx:if="{{configured && !error}}" class="surface">
    <view class="surface-list">
      <view class="list-item">
        <view class="tile {{bound ? 'tile-blue' : 'tile-neutral'}}"><text class="i i-user"></text></view>
        <view class="list-main">
          <view class="list-title">
            <text class="truncate">{{loading ? '读取中…' : (bound ? playerName : '未绑定游戏账号')}}</text>
            <text wx:if="{{levelLabel}}" class="badge {{isAdmin ? 'tone-accent' : ''}}">{{levelLabel}}</text>
          </view>
          <view class="list-sub">{{serverName}}</view>
        </view>
      </view>
    </view>
    <view wx:if="{{bound}}" class="surface-body">
      <view class="kv">
        <text class="kv-key">余额</text>
        <text class="kv-value num">{{balanceText}}</text>
        <text class="kv-key">今日在线</text>
        <text class="kv-value">{{todayText}}</text>
        <text class="kv-key">本月在线</text>
        <text class="kv-value">{{monthText}}</text>
        <text class="kv-key">累计在线</text>
        <text class="kv-value">{{totalText}}</text>
      </view>
    </view>
  </view>

  <!-- 行为记录 -->
  <view wx:if="{{bound}}" class="surface">
    <view class="surface-list">
      <view class="list-item" hover-class="hover" bindtap="openActivity">
        <view class="tile tile-pink"><text class="i i-activity"></text></view>
        <view class="list-main">
          <view class="list-title"><text class="truncate">我的行为记录</text></view>
          <view class="list-sub">加入、聊天、方块、实体等游戏内记录</view>
        </view>
        <text class="i i-sm i-chevron-right muted"></text>
      </view>
    </view>
  </view>

  <!-- 绑定 -->
  <view wx:if="{{configured && !error && !loading && !bound}}" class="surface">
    <view class="surface-head"><text class="surface-title">绑定游戏账号</text></view>
    <view class="surface-body">
      <block wx:if="{{bindCode}}">
        <view class="me-code mono num" bindtap="copyBindCode">{{bindCode}}</view>
        <view class="small muted me-center">{{bindRemain}} · 点击复制</view>
        <view class="callout me-steps">
          <text class="i i-info"></text>
          <view class="callout-body">
            <view class="callout-text">1. 进入服务器，在聊天框输入 /c:bind</view>
            <view class="callout-text">2. 再把上面的 6 位绑定码发送到聊天框</view>
            <view class="callout-text">完成后本页会自动刷新</view>
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="small muted">用微信绑定游戏角色后，可在这里查看余额与在线时长。</view>
        <view class="btn btn-primary btn-block btn-lg me-action {{requesting ? 'disabled' : ''}}" hover-class="hover" bindtap="requestBind">
          <text class="i {{requesting ? 'i-loader spin' : 'i-link'}}"></text>
          <text>获取绑定码</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 管理 -->
  <view class="surface">
    <view class="surface-head"><text class="surface-title">服务器管理</text></view>
    <view class="surface-list">
      <view class="list-item" hover-class="hover" bindtap="openAdmin">
        <view class="tile tile-violet"><text class="i i-shield"></text></view>
        <view class="list-main">
          <view class="list-title"><text class="truncate">进入管理端</text></view>
          <view class="list-sub">{{isAdmin ? '以游戏内管理员身份管理实例' : '用访问令牌添加或管理实例'}}</view>
        </view>
        <text class="i i-sm i-chevron-right muted"></text>
      </view>
      <view wx:if="{{isAdmin}}" class="list-item" hover-class="hover" bindtap="approveDesktop">
        <view class="tile tile-teal"><text class="i i-monitor"></text></view>
        <view class="list-main">
          <view class="list-title"><text class="truncate">登录桌面端</text></view>
          <view class="list-sub">扫描桌面端二维码或输入登录码</view>
        </view>
        <text class="i i-sm i-chevron-right muted"></text>
      </view>
    </view>
  </view>

  <!-- 账号操作 -->
  <view wx:if="{{bound}}" class="surface">
    <view class="surface-list">
      <view class="list-item" hover-class="hover" bindtap="unbind">
        <view class="tile tile-danger"><text class="i i-unplug"></text></view>
        <view class="list-main">
          <view class="list-title"><text class="truncate text-danger">解除绑定</text></view>
        </view>
      </view>
    </view>
  </view>
</view>
