/* 首页：状态统计格、在线头像条、公告正文 */
.home-retry {
  margin-top: 6px;
}
.home-status {
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.home-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}
.home-uptime {
  font-size: var(--fs-body);
  line-height: var(--lh-body);
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.home-online {
  display: flex;
  gap: 12px;
  padding: 12px 16px;
  white-space: nowrap;
  box-sizing: border-box;
}
.home-online-chip {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  width: 56px;
  flex: none;
}
.home-online-chip .small {
  max-width: 56px;
  text-align: center;
}
.home-notice-body {
  margin-top: 6px;
  color: var(--c-text-2);
  font-size: var(--fs-subheadline);
  line-height: var(--lh-subheadline);
  white-space: pre-wrap;
  word-break: break-word;
}
