/* 地图页：画布铺满标签页可视区域，控件浮在画布上 */
.map-root {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--c-bg);
}
.map-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* 顶部：图层开关与上报中断提示 */
.map-top {
  position: absolute;
  left: 12px;
  right: 12px;
  top: 12px;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  pointer-events: none;
}
.map-top .chips,
.map-stale {
  pointer-events: auto;
}
.map-chip {
  box-shadow: inset 0 0 0 0.5px var(--c-line), 0 2px 8px rgba(28, 28, 28, 0.12);
}

/* 右侧：缩放、全图与定位按钮 */
.map-tools {
  position: absolute;
  right: 12px;
  top: 56px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.map-tool {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 12px;
  background: var(--c-elevated);
  color: var(--c-text);
  box-shadow: 0 0 0 0.5px var(--c-line), 0 2px 8px rgba(28, 28, 28, 0.12);
}
.map-tool.hover {
  background: var(--c-fill-2);
}

/* 底部：选中信息与不在主世界的玩家 */
.map-bottom {
  position: absolute;
  left: 12px;
  right: 12px;
  bottom: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.map-card {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  padding: 10px 12px;
  border-radius: 16px;
  background: var(--c-elevated);
  box-shadow: 0 0 0 0.5px var(--c-line), 0 8px 24px rgba(28, 28, 28, 0.12);
}
.map-other + .map-other::before {
  content: "、";
  color: var(--c-text-3);
}

.map-retry {
  margin-top: 12px;
}
