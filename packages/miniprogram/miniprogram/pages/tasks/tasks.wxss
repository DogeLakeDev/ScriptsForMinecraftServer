.task + .task {
  border-top: 0.5px solid var(--c-line);
}
.task-end {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
  flex: none;
}
.task-detail {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin: 0 8px 12px 52px;
}
.steps {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.step {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}
.step-main {
  flex: 1;
  min-width: 0;
}
.step-message {
  margin-top: 2px;
  word-break: break-all;
}
.code {
  display: block;
  max-height: 240px;
  overflow: auto;
}
