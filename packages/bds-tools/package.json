{
  "name": "@sfmc-bds/bds-tools",
  "version": "0.2.0-beta.8",
  "description": "SFMC BDS auto-updater, lifecycle manager, and behavior-pack assembler",
  "author": "Shiroha7z",
  "license": "ISC",
  "type": "module",
  "homepage": "https://github.com/DogeLakeDev/ScriptsForMinecraftServer/tree/main/packages/bds-tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DogeLakeDev/ScriptsForMinecraftServer.git",
    "directory": "packages/bds-tools"
  },
  "bugs": {
    "url": "https://github.com/DogeLakeDev/ScriptsForMinecraftServer/issues"
  },
  "keywords": [
    "bds",
    "minecraft-bedrock",
    "scriptsforminecraftserver",
    "sfmc",
    "updater"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "dist/bds-manager.js",
  "exports": {
    ".": "./dist/bds-manager.js",
    "./bds-manager": "./dist/bds-manager.js",
    "./check-update": "./dist/check-update.js",
    "./host-platform": "./dist/host-platform.js",
    "./pack-manager": "./dist/cli-pack-manager.js",
    "./pack-manager-lib": "./dist/pack-manager.js",
    "./process-probe": "./dist/process-probe.js",
    "./package.json": "./package.json",
    "./taskbar": "./dist/taskbar.js",
    "./types": {
      "types": "./dist/types.d.ts"
    },
    "./update-result": "./dist/update-result.js",
    "./world-packs": "./dist/world-packs.js",
    "./pack-update": "./dist/pack-update/index.js",
    "./zipx": "./dist/zipx.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "sfmc-esbuild-transpile --dts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx src/bds-manager.ts",
    "prepublishOnly": "npm run build",
    "rollback": "node recovery.js",
    "start": "node dist/bds-manager.js start",
    "status": "node dist/bds-manager.js status",
    "stop": "node dist/bds-manager.js stop",
    "test": "npm run build && node --test is-main.test.mjs pack-manager-lifecycle.test.mjs pack-update-config.test.mjs pack-update-policy.test.mjs process-probe.test.mjs server-properties.test.mjs world-packs.test.mjs zipx.test.mjs host-platform.test.mjs dist/qq-events-notify.test.js",
    "typecheck": "tsc7 --noEmit",
    "update": "node dist/check-update.js",
    "update:check": "node dist/check-update.js --check-only",
    "update:force": "node dist/check-update.js --force",
    "watch": "node dist/bds-manager.js watch"
  },
  "dependencies": {
    "@sfmc-bds/sdk": "^0.2.0-beta.8",
    "jszip": "^3.10.1",
    "node-html-parser": "^9.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
