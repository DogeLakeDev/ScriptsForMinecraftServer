{
  "name": "@sfmc-bds/db-server",
  "version": "0.2.0-beta.4",
  "description": "SFMC SQLite HTTP REST backend — configs, modules, gameplay data",
  "author": "Shiroha7z",
  "license": "AGPL-3.0-only",
  "type": "module",
  "homepage": "https://github.com/DogeLakeDev/ScriptsForMinecraftServer/tree/main/db-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DogeLakeDev/ScriptsForMinecraftServer.git",
    "directory": "db-server"
  },
  "bugs": {
    "url": "https://github.com/DogeLakeDev/ScriptsForMinecraftServer/issues"
  },
  "keywords": [
    "minecraft-bedrock",
    "rest-api",
    "scriptsforminecraftserver",
    "sfmc",
    "sqlite"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "sfmc-esbuild-transpile --dts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx src/index.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json}\"",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "test": "node --test dist/*.test.js",
    "test:api": "npm run build && node scripts/test-db-api.mjs",
    "typecheck": "tsc7 --noEmit"
  },
  "dependencies": {
    "@sfmc-bds/sdk": "^0.2.0-beta.5",
    "sql-template-strings": "^2.2.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
