{
  "name": "sfmc-module",
  "displayName": "SFMC Module",
  "description": "SFMC 模块作者工具：脚手架、测试、Watch；依赖官方 ESLint 扩展以消费 @sfmc-bds/eslint-plugin",
  "version": "0.1.0",
  "publisher": "sfmc-bds",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Linters",
    "Other"
  ],
  "extensionRecommendations": [
    "dbaeumer.vscode-eslint"
  ],
  "activationEvents": [
    "workspaceContains:**/sapi/manifest.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sfmcModule",
          "icon": "media/icon.svg",
          "title": "SFMC"
        }
      ]
    },
    "views": {
      "sfmcModule": [
        {
          "id": "sfmcModules",
          "name": "SFMC Modules"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "sfmcModule.build",
          "when": "view == sfmcModules",
          "group": "navigation@1"
        },
        {
          "command": "sfmcModule.reload",
          "when": "view == sfmcModules",
          "group": "navigation@2"
        },
        {
          "command": "sfmcModule.refreshTree",
          "when": "view == sfmcModules",
          "group": "navigation@3"
        },
        {
          "command": "sfmcModule.setRoot",
          "when": "view == sfmcModules",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "sfmcModule.build",
          "when": "view == sfmcModules && viewItem == sfmcModule",
          "group": "sfmc@1"
        },
        {
          "command": "sfmcModule.reload",
          "when": "view == sfmcModules && viewItem == sfmcModule",
          "group": "sfmc@2"
        },
        {
          "command": "sfmcModule.enable",
          "when": "view == sfmcModules && viewItem == sfmcModule",
          "group": "sfmc@3"
        },
        {
          "command": "sfmcModule.disable",
          "when": "view == sfmcModules && viewItem == sfmcModule",
          "group": "sfmc@4"
        },
        {
          "command": "sfmcModule.moduleInfoAction",
          "when": "view == sfmcModules && viewItem == sfmcModule",
          "group": "sfmc@5"
        },
        {
          "command": "sfmcModule.setRoot",
          "when": "view == sfmcModules && viewItem == sfmcModule",
          "group": "sfmc@6"
        }
      ]
    },
    "commands": [
      {
        "command": "sfmcModule.newModule",
        "title": "SFMC: New Module"
      },
      {
        "command": "sfmcModule.runTests",
        "title": "SFMC: Run Module Tests"
      },
      {
        "command": "sfmcModule.openPlayground",
        "title": "SFMC: 脚本沙箱"
      },
      {
        "command": "sfmcModule.startDebug",
        "title": "SFMC: 启动并调试"
      },
      {
        "command": "sfmcModule.showLog",
        "title": "SFMC: Show Extension Log"
      },
      {
        "command": "sfmcModule.configureLogFilter",
        "title": "SFMC: 日志过滤…"
      },
      {
        "command": "sfmcModule.clearAndApplyLogFilter",
        "title": "SFMC: 清除并应用日志过滤"
      },
      {
        "command": "sfmcModule.locateSandboxLogNode",
        "title": "SFMC: 定位沙箱日志节点"
      },
      {
        "command": "sfmcModule.setRoot",
        "title": "SFMC: 设置工作目录…",
        "icon": "$(folder)"
      },
      {
        "command": "sfmcModule.runTestsAction",
        "title": "SFMC: Run Tests"
      },
      {
        "command": "sfmcModule.openPlaygroundAction",
        "title": "SFMC: Open Playground (Tree)"
      },
      {
        "command": "sfmcModule.startDebugAction",
        "title": "SFMC: Start Debug (Tree)"
      },
      {
        "command": "sfmcModule.moduleInfoAction",
        "title": "SFMC: Module Info"
      },
      {
        "command": "sfmcModule.refreshTree",
        "title": "SFMC: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "sfmcModule.watchStarted",
        "title": "SFMC: Watch Started"
      },
      {
        "command": "sfmcModule.watchStopped",
        "title": "SFMC: Watch Stopped"
      },
      {
        "command": "sfmcModule.startWatch",
        "title": "SFMC: Start Watch"
      },
      {
        "command": "sfmcModule.stopWatch",
        "title": "SFMC: Stop Watch"
      },
      {
        "command": "sfmcModule.build",
        "title": "SFMC: 编译模块",
        "icon": "$(package)"
      },
      {
        "command": "sfmcModule.reload",
        "title": "SFMC: Reload to BDS",
        "icon": "$(sync)"
      },
      {
        "command": "sfmcModule.enable",
        "title": "SFMC: 启用模块",
        "icon": "$(check)"
      },
      {
        "command": "sfmcModule.disable",
        "title": "SFMC: 关闭模块",
        "icon": "$(circle-slash)"
      }
    ],
    "configuration": {
      "title": "SFMC Module",
      "properties": {
        "sfmc.root": {
          "type": "string",
          "default": "",
          "description": "SFMC 工作目录（运行时根，含 configs/、modules/；不必是源码仓库）。Watch / 编译 / Reload / 启停需要；可用「SFMC: 设置工作目录…」修改，缺失或无效时也会弹出目录选择。"
        },
        "sfmc.cliPath": {
          "type": "string",
          "default": "",
          "description": "可选。sfmc CLI 入口脚本（如 node_modules/@sfmc-bds/cli/dist/main.js）。留空则从扩展/devkit 安装树、PATH 或环境变量 SFMC_CLI 解析；与 sfmc.root 无关。"
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/playground/graph/order.test.ts src/playground/graph/expr.test.ts src/playground/graph/parseExpected.test.ts src/playground/graph/materialize.test.ts src/playground/graph/sourceMap.test.ts src/playground/graph-ui/metaForm/detect.test.ts src/playground/graph-ui/metaForm/EnumSelect.test.ts src/playground/graph-ui/metaForm/NestedForm.test.ts src/playground/graph-ui/metaForm/assertFields.test.ts src/playground/graph-ui/metaForm/expectedMeta.test.ts src/playground/graph-ui/metaForm/insertMenu.test.ts src/panels/moduleRootKey.test.ts",
    "package": "npx @vscode/vsce package"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@sfmc-bds/devkit": "^0.1.0-beta.0",
    "@sfmc-bds/sdk": "^0.2.0-beta.6",
    "@vscode/codicons": "^0.0.46-24",
    "@xyflow/react": "^12.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.1"
  }
}
